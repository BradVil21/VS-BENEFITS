{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vshealthbenefits.com" }],
      "destination": "https://www.vshealthbenefits.com/:path*",
      "permanent": true
    },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/get-a-quote.html", "destination": "/get-a-quote", "permanent": true },
    { "source": "/1099-health-insurance.html", "destination": "/1099-health-insurance", "permanent": true },
    { "source": "/family-health-insurance.html", "destination": "/family-health-insurance", "permanent": true },
    { "source": "/small-business-health-insurance.html", "destination": "/small-business-health-insurance", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/privacy",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
