{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vshealthbenefits.com" }],
      "destination": "https://www.vshealthbenefits.com/:path*",
      "permanent": true
    },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/get-a-quote", "destination": "/quote", "permanent": true },
    { "source": "/get-a-quote.html", "destination": "/quote", "permanent": true },
    { "source": "/1099-health-insurance.html", "destination": "/1099-health-insurance", "permanent": true },
    { "source": "/family-health-insurance.html", "destination": "/family-health-insurance", "permanent": true },
    { "source": "/small-business-health-insurance.html", "destination": "/small-business-health-insurance", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/ppo-health-insurance.html", "destination": "/ppo-health-insurance", "permanent": true },
    { "source": "/truck-driver-health-insurance.html", "destination": "/truck-driver-health-insurance", "permanent": true },
    { "source": "/health-insurance-uber-drivers.html", "destination": "/health-insurance-uber-drivers", "permanent": true },
    { "source": "/seguro-de-salud-miami.html", "destination": "/seguro-de-salud-miami", "permanent": true },
    { "source": "/dental-vision-insurance.html", "destination": "/dental-vision-insurance", "permanent": true },
    { "source": "/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/privacy",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
